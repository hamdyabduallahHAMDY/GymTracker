@page "/"

<PageTitle>GymTracker</PageTitle>

<div class="dashboard-page">
    <section class="welcome-card">
        <p class="eyebrow">YOUR OFFLINE WORKOUT LOG</p>

        <h1>Welcome to GymTracker</h1>

        <p>
            Build your training program, record your sets,
            and track your progress completely offline.
        </p>

        <a class="primary-button" href="programs">
            Create Your First Program
        </a>
    </section>

    <section class="dashboard-grid">
        <a class="dashboard-card" href="programs">
            <span class="card-icon">📋</span>

            <div>
                <h2>Programs</h2>
                <p>Create and manage workout programs.</p>
            </div>
        </a>

        <a class="dashboard-card" href="workout">
            <span class="card-icon">🏋️</span>

            <div>
                <h2>Start Workout</h2>
                <p>Record weight, repetitions, and sets.</p>
            </div>
        </a>

        <a class="dashboard-card" href="history">
            <span class="card-icon">📈</span>

            <div>
                <h2>History</h2>
                <p>Review completed workout sessions.</p>
            </div>
        </a>

        <a class="dashboard-card" href="exercises">
            <span class="card-icon">💪</span>

            <div>
                <h2>Exercises</h2>
                <p>Manage your exercise library.</p>
            </div>
        </a>
    </section>
</div>