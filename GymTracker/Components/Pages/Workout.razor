@page "/workout"

@using GymTracker.Data
@using GymTracker.Models

@inject AppDatabase Database
@inject NavigationManager Navigation
@inject IServiceProvider ServiceProvider

<PageTitle>Start Workout</PageTitle>

<div class="page-container">

    <div class="page-header">

        <div>
            <p class="eyebrow">
                TRAINING SESSION
            </p>

            <h1>
                Start Workout
            </h1>

            <p>
                Choose one of your fixed workout days.
            </p>
        </div>

    </div>


    @if (isLoading)
    {
        <p>
            Loading...
        </p>
    }
    else
    {

        @if (unfinishedSession is not null &&
            unfinishedWorkoutDay is not null)
        {
            <div class="resume-workout-card">

                <div>

                    <p class="eyebrow">
                        UNFINISHED WORKOUT
                    </p>

                    <h2>
                        @unfinishedWorkoutDay.Name
                    </h2>

                    <p>
                        Started:
                        @unfinishedSession.Date.ToString(
                        "dd MMM yyyy HH:mm")
            </p>

        </div>

        <div class="resume-actions">

            <button class="primary-button"
                    @onclick="ResumeWorkout">
                Resume Workout
            </button>

            <button class="danger-button"
                    @onclick="AskToTerminateWorkout">
                Terminate
            </button>

        </div>

    </div>
        }


        @if (workoutDays.Count == 0)
        {
            <div class="empty-state">

                <span class="empty-state-icon">
                    🏋️
                </span>

                <h2>
                    No workouts available
                </h2>

                <p>
                    The fixed workout plan could not be found.
                </p>

            </div>
        }
        else
        {
            <div class="workout-day-grid">

                @foreach (var day in workoutDays)
                {
                    <button class="workout-day-card"
                            @onclick="() =>
                            StartWorkout(day)">

            <span class="day-number">
                DAY @day.DayNumber
            </span>

                        <h2>
                            @day.Name
                        </h2>

                        <p>
                            Start workout
                        </p>

                    </button>
                }

            </div>
        }
    }

</div>


@if (showTerminateConfirmation)
{
    <div class="confirm-overlay">

        <div class="confirm-dialog">

            <h2>
                Terminate workout?
            </h2>

            <p>
                This unfinished workout and all entered sets
                will be permanently deleted.
            </p>

            <div class="confirm-actions">

                <button class="secondary-button"
                        @onclick="CancelTerminateWorkout">
                    Keep Workout
                </button>

                <button class="danger-button"
                        @onclick="ConfirmTerminateWorkout">
                    Terminate
                </button>

            </div>

        </div>

    </div>
}


@code {

    private List<WorkoutDay>
        workoutDays = new();

    private WorkoutSession?
        unfinishedSession;

    private WorkoutDay?
        unfinishedWorkoutDay;

    private bool isLoading = true;

    private bool
        showTerminateConfirmation;


    protected override async Task OnInitializedAsync()
    {
        await LoadPage();
    }


    private async Task LoadPage()
    {
        isLoading = true;

        unfinishedSession =
            await Database
                .GetActiveWorkoutSessionAsync();

        if (unfinishedSession is not null)
        {
            unfinishedWorkoutDay =
                await Database
                    .GetWorkoutDayAsync(
                        unfinishedSession
                            .WorkoutDayId);
        }
        else
        {
            unfinishedWorkoutDay = null;
        }


        var programs =
            await Database
                .GetWorkoutProgramsAsync();

        var fixedProgram =
            programs
                .OrderBy(x => x.Id)
                .FirstOrDefault();

        if (fixedProgram is not null)
        {
            workoutDays =
                await Database
                    .GetWorkoutDaysAsync(
                        fixedProgram.Id);
        }
        else
        {
            workoutDays.Clear();
        }


        workoutDays =
            workoutDays
                .OrderBy(
                    x => x.DayNumber)
                .ToList();

        isLoading = false;
    }


    private void StartWorkout(
        WorkoutDay day)
    {
        // Prevent starting another workout
        // while one is unfinished.
        if (unfinishedSession is not null)
        {
            return;
        }

        Navigation.NavigateTo(
            $"/workout/start/{day.Id}");
    }


    private void ResumeWorkout()
    {
        if (unfinishedSession is null)
            return;

        Navigation.NavigateTo(
            $"/workout/start/" +
            $"{unfinishedSession.WorkoutDayId}");
    }


    private void AskToTerminateWorkout()
    {
        if (unfinishedSession is null)
            return;

        showTerminateConfirmation = true;
    }


    private void CancelTerminateWorkout()
    {
        showTerminateConfirmation = false;
    }


    private async Task ConfirmTerminateWorkout()
    {
        if (unfinishedSession is null)
            return;

#if ANDROID
        var androidAlarmService =
            ServiceProvider.GetService<
                GymTracker.Platforms.Android
                    .AndroidRestAlarmService>();

        androidAlarmService?.CancelAlarm();
#endif

        await Database
            .TerminateActiveWorkoutAsync(
                unfinishedSession.Id);

        showTerminateConfirmation = false;

        unfinishedSession = null;

        unfinishedWorkoutDay = null;

        // Reload the page so the workout
        // selector becomes available again.
        await LoadPage();
    }
}
